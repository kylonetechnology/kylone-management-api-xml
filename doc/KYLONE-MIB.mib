	-- groups 15 to 19 were added in module revision 2.1

	engStatus	OBJECT IDENTIFIER ::= { skylone 15 }

	-- kylone.engStatus subtree: the streaming engine and the unit as a whole
	engUp OBJECT-TYPE
		SYNTAX  Integer32 (0..1)
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"1 when the streaming engine answers status requests, 0 otherwise"
		::= { engStatus 1 }

	engUptime OBJECT-TYPE
		SYNTAX  TimeTicks
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Time since the streaming engine started"
		::= { engStatus 2 }

	engEndpoints OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Endpoints the engine currently serves (viewer and relay sessions)"
		::= { engStatus 3 }

	engServices OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Streams the engine handles, all sections together"
		::= { engStatus 4 }

	engOutputRate OBJECT-TYPE
		SYNTAX  Gauge32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Sum of the streams' output rates, bytes per second"
		::= { engStatus 5 }

	engSystemUptime OBJECT-TYPE
		SYNTAX  TimeTicks
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Time since the unit booted"
		::= { engStatus 6 }

	engSystemTime OBJECT-TYPE
		SYNTAX  DateAndTime
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"The unit's clock"
		::= { engStatus 7 }

	engTemperature OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"CPU temperature in degrees Celsius; -1 when the unit has no sensor"
		::= { engStatus 8 }

	engMemoryTotal OBJECT-TYPE
		SYNTAX  Gauge32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Memory installed, megabytes"
		::= { engStatus 9 }

	engMemoryAvailable OBJECT-TYPE
		SYNTAX  Gauge32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Memory available, megabytes"
		::= { engStatus 10 }

	peStatus	OBJECT IDENTIFIER ::= { skylone 16 }

	-- kylone.peStatus subtree
	peNumber OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Number of processing nodes (GPU or encoder boards of the processing modules)"
		::= { peStatus 1 }

	peTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF PeEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"List of processing nodes (GPU or encoder boards of the processing modules) entries"
		::= { peStatus 2 }

	peEntry OBJECT-TYPE
		SYNTAX  PeEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"An entry of the processing nodes (GPU or encoder boards of the processing modules) table"
		INDEX   { peIndex }
		::= { peTable 1 }

	PeEntry ::= SEQUENCE {
		peIndex Integer32,
		peModule DisplayString,
		peNode DisplayString,
		peProcesses Integer32,
		peMemory Integer32,
		peGpu Integer32,
		peDecoder Integer32,
		peEncoder Integer32,
		pePower Integer32,
		peTemperature Integer32
	}

	peIndex OBJECT-TYPE
		SYNTAX  Integer32 (1..2147483647)
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
        		"A unique value for each processing node"
		::= { peEntry 1 }

	peModule OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Module that owns the node"
		::= { peEntry 2 }

	peNode OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Name of the node as the module reports it"
		::= { peEntry 3 }

	peProcesses OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Processes running on the node; -1 when not reported"
		::= { peEntry 4 }

	peMemory OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Memory utilisation of the node, percent; -1 when not reported"
		::= { peEntry 5 }

	peGpu OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"GPU utilisation, percent; -1 when not reported"
		::= { peEntry 6 }

	peDecoder OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Decoder utilisation, percent; -1 when not reported"
		::= { peEntry 7 }

	peEncoder OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Encoder utilisation, percent; -1 when not reported"
		::= { peEntry 8 }

	pePower OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Power draw, watts; -1 when not reported"
		::= { peEntry 9 }

	peTemperature OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Temperature, degrees Celsius; -1 when not reported"
		::= { peEntry 10 }

	stdStatus	OBJECT IDENTIFIER ::= { skylone 17 }

	-- kylone.stdStatus subtree
	stdNumber OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Number of stand-ins (protection switches between a service and its fall-back feed)"
		::= { stdStatus 1 }

	stdTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF StdEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"List of stand-ins (protection switches between a service and its fall-back feed) entries"
		::= { stdStatus 2 }

	stdEntry OBJECT-TYPE
		SYNTAX  StdEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"An entry of the stand-ins (protection switches between a service and its fall-back feed) table"
		INDEX   { stdIndex }
		::= { stdTable 1 }

	StdEntry ::= SEQUENCE {
		stdIndex Integer32,
		stdName DisplayString,
		stdMode DisplayString,
		stdTrigger DisplayString,
		stdArmed Integer32,
		stdState DisplayString,
		stdFeed DisplayString,
		stdLock DisplayString,
		stdStart DateAndTime,
		stdDuration TimeTicks,
		stdBitrate Gauge32,
		stdNumService Integer32,
		stdRestarts Integer32
	}

	stdIndex OBJECT-TYPE
		SYNTAX  Integer32 (1..2147483647)
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
        		"A unique value for each stand-in"
		::= { stdEntry 1 }

	stdName OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Name of the stand-in"
		::= { stdEntry 2 }

	stdMode OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Mode of the stand-in (guard, manual, ...)"
		::= { stdEntry 3 }

	stdTrigger OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"What arms the switch (aut = automatic, man = manual)"
		::= { stdEntry 4 }

	stdArmed OBJECT-TYPE
		SYNTAX  Integer32 (0..1)
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"1 when the stand-in is armed"
		::= { stdEntry 5 }

	stdState OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Current state: pass (the primary feed runs), or the stand-in feed is on air"
		::= { stdEntry 6 }

	stdFeed OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Name of the fall-back feed"
		::= { stdEntry 7 }

	stdLock OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Lock status of the stream"
		::= { stdEntry 8 }

	stdStart OBJECT-TYPE
		SYNTAX  DateAndTime
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Start time of the stream"
		::= { stdEntry 9 }

	stdDuration OBJECT-TYPE
		SYNTAX  TimeTicks
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Running time of the stream"
		::= { stdEntry 10 }

	stdBitrate OBJECT-TYPE
		SYNTAX  Gauge32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Output rate, bytes per second"
		::= { stdEntry 11 }

	stdNumService OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Services the stand-in covers"
		::= { stdEntry 12 }

	stdRestarts OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Restarts since the engine started"
		::= { stdEntry 13 }

	netStatus	OBJECT IDENTIFIER ::= { skylone 18 }

	-- kylone.netStatus subtree
	netNumber OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Number of network interfaces"
		::= { netStatus 1 }

	netTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF NetEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"List of network interfaces entries"
		::= { netStatus 2 }

	netEntry OBJECT-TYPE
		SYNTAX  NetEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"An entry of the network interfaces table"
		INDEX   { netIndex }
		::= { netTable 1 }

	NetEntry ::= SEQUENCE {
		netIndex Integer32,
		netName DisplayString,
		netLinkUp Integer32,
		netSpeed Gauge32,
		netRxMBytes Counter32,
		netTxMBytes Counter32,
		netRxErrors Counter32,
		netTxErrors Counter32
	}

	netIndex OBJECT-TYPE
		SYNTAX  Integer32 (1..2147483647)
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
        		"A unique value for each interface"
		::= { netEntry 1 }

	netName OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Interface name"
		::= { netEntry 2 }

	netLinkUp OBJECT-TYPE
		SYNTAX  Integer32 (0..1)
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"1 when the link is up"
		::= { netEntry 3 }

	netSpeed OBJECT-TYPE
		SYNTAX  Gauge32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Link speed, megabits per second; 0 when unknown"
		::= { netEntry 4 }

	netRxMBytes OBJECT-TYPE
		SYNTAX  Counter32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Megabytes received on the interface since boot"
		::= { netEntry 5 }

	netTxMBytes OBJECT-TYPE
		SYNTAX  Counter32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Megabytes transmitted on the interface since boot"
		::= { netEntry 6 }

	netRxErrors OBJECT-TYPE
		SYNTAX  Counter32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Receive errors since boot"
		::= { netEntry 7 }

	netTxErrors OBJECT-TYPE
		SYNTAX  Counter32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Transmit errors since boot"
		::= { netEntry 8 }

	stoStatus	OBJECT IDENTIFIER ::= { skylone 19 }

	-- kylone.stoStatus subtree
	stoNumber OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
