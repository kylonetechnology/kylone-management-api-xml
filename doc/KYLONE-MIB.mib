KYLONE-MIB DEFINITIONS ::= BEGIN
	-- Version: 2.1
	-- SUBTREE: 1.3.6.1.4.1.51009
	-- iso.org.dod.internet.private.enterprises.skylone
	--
	-- The Kylone headend objects. The enterprise number 51009 is Skylone's IANA
	-- assignment; Kylone units register their objects under it, the module identity
	-- itself at skylone 100. The object identifiers of the 1.0 module (SKYLONE-MIB,
	-- 2018) are unchanged; the groups that belonged to another product (3, 4, 5) are
	-- not part of this module.
	IMPORTS
		MODULE-IDENTITY, OBJECT-TYPE, Gauge32, Counter32, TimeTicks, Integer32, enterprises
			FROM SNMPv2-SMI
		TEXTUAL-CONVENTION, DisplayString, TimeStamp, DateAndTime
			FROM SNMPv2-TC;

	skylone	OBJECT IDENTIFIER ::= { enterprises 51009 }

	kylone MODULE-IDENTITY
		LAST-UPDATED
			"202610021800Z"
		ORGANIZATION
			"Kylone"
		CONTACT-INFO
			"Kylone
			https://kylone.com
			support@kylone.com"
		DESCRIPTION
			"The MIB of the Kylone headend units: product and version, system
			 load, and the state of the receivers, inputs, multiplexers, modulators,
			 processing modules, outputs, local files and connected peers."
		REVISION
			"202610021800Z"
		DESCRIPTION
			"Revision 2.1: engStatus (15, engine and unit figures), peStatus (16,
			 processing nodes), stdStatus (17, stand-ins), netStatus (18, network
			 interfaces), stoStatus (19, storage volumes); restart counters appended
			 to the stream tables, speed, fps, dropped frames and service counts on
			 the module table, rate and service count on the input table."
		REVISION
			"202610021200Z"
		DESCRIPTION
			"Kylone module. Objects of the 2018 SKYLONE-MIB kept with their
			 identifiers; another product's groups 3-5 dropped; scalars served with
			 their .0 instance; DateAndTime columns served as the 11-octet form;
			 srt added to the input stream types; agent served by one persistent
			 process."
		REVISION
			"201811252137Z"
		DESCRIPTION
			"Initial revision (SKYLONE-MIB 1.0)"
	::= { skylone 100 }

	BufferSize ::= TEXTUAL-CONVENTION
		DISPLAY-HINT "d-2"
		STATUS  current
		DESCRIPTION
			"A buffer type definition which is two digit shifted value
			 in format secods.milliseconds"
		SYNTAX  Integer32 (0..10000)

