	}
 
	lfIndex OBJECT-TYPE
		SYNTAX  Integer32 (1..2147483647)
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
        		"A unique value for each Local File"
		::= { lfEntry 1 }

	lfName OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Name of the Local File"
