	lfLoop OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Loop Status of the Local File"
		::= { lfEntry 4 }

	lfLoopCount OBJECT-TYPE
		SYNTAX  Integer32
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
        		"Loop Count of the Local File"
